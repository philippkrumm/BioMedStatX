.DS_Store
__pycache__/
*.pyc
*.pyo
.venv/
.venv*_backup_*/

# Claude Code internal files (local only — agents, skills, settings, plans)
.claude/

# Local Claude Code pre-commit hook — private; active via `git config core.hooksPath .githooks`
.githooks/

# R output artifacts
Rplots.pdf

# Dead-code audit report (generated artifact)
tools/audit_report.md

# Local Windows build scripts with hardcoded paths
build.bat

# Generated report outputs (auto-generated by the application)
docs/test_report_preview.html
# Root-level analysis reports are generated output (docs/, src/templates/,
# assets/ hold the tracked HTML); never commit them.
/*.html

# Build artifacts
build/
dist/
*.egg-info/

# The packaged release archives, staged in the repo root before being uploaded
# to a GitHub release. dist/ and build/ are ignored above; these are the zips
# cut from them, and at ~117 MB each a stray `git add .` would bloat the history
# permanently and be rejected outright by GitHub's 100 MB per-file limit.
BioMedStatX_macOS.zip
BioMedStatX_windows.zip
BioMedStatX*.app.zip

# Test & coverage
.coverage
htmlcov/

# Logs & temp files
*.log
*.tmp
*.bak

# PyInstaller build log
build_log.txt

# Editor & personal tool configs (not relevant for end users or contributors)
.cursorrules
.vscode/
.continue/
pyrefly.toml

# AI assistant instruction files (personal workflow)
AGENTS.md
CLAUDE.md
.mcp.json

# Search-tool leftovers
.ignore

# Frozen-import smoke output, the same class as build_log.txt above
smoke-report.txt

# Internal working notes: audit rounds, plans, design specs, findings lists.
# They stay on disk and are worth keeping -- they are simply not user-facing
# documentation, and docs/ is what a visitor opens expecting guides. A public
# findings list also goes stale silently: the one removed here still reported an
# open issue in DataVisualizer, a class that no longer exists.
docs/superpowers/
docs/audit/
docs/PLOT_STYLE_AUDIT.md

# One-off dev scripts
refactor_imports.py

# Local example images / scratch assets
decision_tree_example.png

# Local audit/working prompts (workflow tooling, not project files)
biomedstatx_v2_release_audit_prompt.md

